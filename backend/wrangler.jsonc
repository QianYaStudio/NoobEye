{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noobeye-stats",
  "main": "worker.js",
  "compatibility_date": "2026-09-13",
  "vars": {
    "ALLOWED_ORIGINS": "https://qianyastudio.github.io,http://localhost:4173,http://127.0.0.1:4173",
    "RESEND_SEGMENT_ID": "",
    "RESEND_TOPIC_ZH": "",
    "RESEND_TOPIC_EN": "",
    "RESEND_TOPIC_JA": "",
    "MAIL_FROM": "NoobEye <noobeye@your-verified-domain.example>",
    "PUBLIC_API_URL": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "noobeye-stats",
      "database_id": "REPLACE_WITH_CREATED_D1_ID"
    }
  ],
  "ratelimits": [
    {
      "name": "EVENT_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "SUBSCRIPTION_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  }
}
